# Smarter Adapter v2 environment template
#
# Quick start:
#   cp .env.example .env
#   chmod 600 .env
#   edit .env
#   python scripts/run_v2.py
#
# The real .env is ignored by Git. Never commit credentials or production
# broker passwords/tokens.

# -----------------------------------------------------------------------------
# Deployment
# -----------------------------------------------------------------------------
SMA_ENVIRONMENT=irrigap

# -----------------------------------------------------------------------------
# Magistrala / Atom
# -----------------------------------------------------------------------------
ATOM_URL=http://127.0.0.1
ATOM_USERNAME=admin
ATOM_PASSWORD=CHANGE_ME

# Alternatively prefer a service/admin token when available:
# ATOM_SERVICE_TOKEN=CHANGE_ME
# ATOM_ADMIN_TOKEN=CHANGE_ME

MAGISTRALA_PUBLISH_URL=http://127.0.0.1
MAGISTRALA_RULES_URL=http://127.0.0.1
MAGISTRALA_READER_URL=http://127.0.0.1:9011

# Management API bearer token.
SMA_API_TOKEN=CHANGE_ME

# -----------------------------------------------------------------------------
# Sensor MQTT input
# -----------------------------------------------------------------------------
# Replace these example Irrigap values for another deployment.
SMA_MQTT_HOST=189.18.9.13
SMA_MQTT_PORT=1883
SMA_MQTT_TOPIC=application/bf9286b1-b02c-4e86-976f-f7d66b75aeb7/device/+/event/up
SMA_MQTT_QOS=0
SMA_MQTT_SOURCE=mqtt:189.18.9.13:1883
SMA_MQTT_CLIENT_ID=smarter-adapter-v2-irrigap

# Optional input authentication:
# SMA_MQTT_USERNAME=CHANGE_ME
# SMA_MQTT_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# LoRaWAN gateway monitoring
# -----------------------------------------------------------------------------
# Enabled by default for SMA_ENVIRONMENT=irrigap. The gateway observer is a
# separate read-only MQTT side input; the main sensor pipeline remains scoped
# to event/up and does not subscribe to gateway traffic.
SMA_GATEWAY_MONITOR_ENABLED=true
SMA_GATEWAY_EXPECTED_INTERVAL=30
SMA_GATEWAY_STALE_AFTER=90
SMA_GATEWAY_OFFLINE_AFTER=180

# Defaults reuse the primary sensor MQTT host/port/credentials. Override only
# when gateway events are exposed through another broker or account.
# SMA_GATEWAY_MQTT_HOST=189.18.9.13
# SMA_GATEWAY_MQTT_PORT=1883
# SMA_GATEWAY_MQTT_QOS=0
# SMA_GATEWAY_MQTT_USERNAME=CHANGE_ME
# SMA_GATEWAY_MQTT_PASSWORD=CHANGE_ME
# SMA_GATEWAY_MQTT_CLIENT_ID=smarter-adapter-gateway-monitor
# SMA_GATEWAY_MQTT_TOPICS=+/gateway/+/event/stats,gateway/+/state/conn,+/gateway/+/state/conn

# -----------------------------------------------------------------------------
# Persistent retry / DLQ
# -----------------------------------------------------------------------------
SMA_RETRY_MAX_ATTEMPTS=20
SMA_RETRY_BASE_DELAY=1
SMA_RETRY_MAX_DELAY=5
SMA_RETRY_POLL_INTERVAL=0.5
SMA_RETRY_BATCH_SIZE=50

# -----------------------------------------------------------------------------
# Alert MQTT side-channel
# -----------------------------------------------------------------------------
# Leave SMA_ALERTS_MQTT_ADDRESS empty to disable MQTT alert publication.
SMA_ALERTS_MQTT_ADDRESS=tcp://189.18.9.13:1883
SMA_ALERTS_TOPIC_BASE=adapter/alerts
SMA_ALERTS_QOS=1
# SMA_ALERTS_MQTT_USERNAME=CHANGE_ME
# SMA_ALERTS_MQTT_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# LLM context MQTT side-channel
# -----------------------------------------------------------------------------
# The adapter builds provider-neutral context; this does not bind SMA to a
# specific model/runtime such as Ollama.
SMA_LLM_CONTEXT_MQTT_ADDRESS=tcp://189.18.9.13:1883
SMA_LLM_CONTEXT_TOPIC_BASE=adapter/llm-context
SMA_LLM_CONTEXT_QOS=1
# SMA_LLM_CONTEXT_MQTT_USERNAME=CHANGE_ME
# SMA_LLM_CONTEXT_MQTT_PASSWORD=CHANGE_ME

# Historical Timescale context / trend summarization.
SMA_LLM_HISTORY_LIMIT=120
SMA_LLM_HISTORY_SERIES_SAMPLES=12
SMA_LLM_HISTORY_MAX_SERIES=16
SMA_LLM_HISTORY_TIMEOUT=2
SMA_INTELLIGENCE_QUEUE_MAX=128

# -----------------------------------------------------------------------------
# Presence
# -----------------------------------------------------------------------------
SMA_DEVICE_STALE_AFTER=300
SMA_DEVICE_OFFLINE_AFTER=1800

# -----------------------------------------------------------------------------
# Optional overrides
# -----------------------------------------------------------------------------
# SMA_STATE_DB=/absolute/path/to/smarter_adapter.sqlite3
# SMA_IRRIGAP_NODES_FILE=/absolute/path/to/irrigap.nodes.json
# SMA_API_HOST=127.0.0.1
# SMA_API_PORT=8082
#
# Shell/systemd environment variables take precedence over values in .env.
