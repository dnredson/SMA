# Copy this file to ../.env (repository root) and fill secrets locally.
# The real .env is ignored by Git and must not be committed.

SMA_ENVIRONMENT=irrigap

ATOM_URL=http://127.0.0.1
ATOM_USERNAME=admin
ATOM_PASSWORD=CHANGE_ME

MAGISTRALA_PUBLISH_URL=http://127.0.0.1
MAGISTRALA_RULES_URL=http://127.0.0.1
MAGISTRALA_READER_URL=http://127.0.0.1:9011

SMA_API_TOKEN=CHANGE_ME

SMA_MQTT_HOST=189.18.9.13
SMA_MQTT_PORT=1883
SMA_MQTT_TOPIC=application/bf9286b1-b02c-4e86-976f-f7d66b75aeb7/device/+/event/up
SMA_MQTT_QOS=0
SMA_MQTT_SOURCE=mqtt:189.18.9.13:1883
SMA_MQTT_CLIENT_ID=smarter-adapter-v2-irrigap

SMA_RETRY_MAX_ATTEMPTS=20
SMA_RETRY_BASE_DELAY=1
SMA_RETRY_MAX_DELAY=5
SMA_RETRY_POLL_INTERVAL=0.5
SMA_RETRY_BATCH_SIZE=50

SMA_ALERTS_MQTT_ADDRESS=tcp://189.18.9.13:1883
SMA_ALERTS_TOPIC_BASE=adapter/alerts
SMA_ALERTS_QOS=1

SMA_LLM_CONTEXT_MQTT_ADDRESS=tcp://189.18.9.13:1883
SMA_LLM_CONTEXT_TOPIC_BASE=adapter/llm-context
SMA_LLM_CONTEXT_QOS=1

SMA_LLM_HISTORY_LIMIT=120
SMA_LLM_HISTORY_SERIES_SAMPLES=12
SMA_LLM_HISTORY_MAX_SERIES=16
SMA_LLM_HISTORY_TIMEOUT=2
SMA_INTELLIGENCE_QUEUE_MAX=128

SMA_DEVICE_STALE_AFTER=300
SMA_DEVICE_OFFLINE_AFTER=1800
